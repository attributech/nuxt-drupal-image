{
  "name": "@attributech/nuxt-drupal-image",
  "version": "0.5.1",
  "description": "Nuxt module for handling Drupal image styles",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/attributech/nuxt-drupal-image.git"
  },
  "keywords": [
    "nuxt",
    "nuxt3",
    "nuxt-module",
    "drupal",
    "image",
    "image-styles"
  ],
  "author": "attribute",
  "license": "MIT",
  "exports": {
    ".": "./dist/module.mjs"
  },
  "main": "./dist/module.mjs",
  "types": "dist/types.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nuxt-module-build build",
    "dev": "nuxi dev playground",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "dev:prepare": "nuxt-module-build build && nuxi prepare playground",
    "release": "release-it",
    "prerelease": "pnpm run lint && pnpm run build",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "nuxi prepare playground && vitest run --coverage --typecheck",
    "test:e2e": "playwright test",
    "playground": "nuxi dev playground",
    "typecheck": "nuxi prepare playground && nuxt typecheck playground"
  },
  "dependencies": {
    "@nuxt/eslint-config": "^1.15.2",
    "@nuxt/module-builder": "^0.8.4",
    "@types/node": "^22.19.19",
    "eslint": "^9.39.4",
    "nuxt-lazyimages": "^0.2.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@nuxt/kit": "^4.4.6",
    "@nuxt/schema": "^4.4.6",
    "@nuxt/test-utils": "^3.23.0",
    "@playwright/test": "^1.60.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.10",
    "happy-dom": "^17.6.3",
    "jsdom": "^26.1.0",
    "nuxt": "^4.4.6",
    "playwright-core": "^1.60.0",
    "release-it": "^21.0.0",
    "vitest": "^3.2.4",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.8"
  },
  "peerDependencies": {
    "nuxt": "^2.16.0 || ^3.0.0 || ^4.0.0"
  },
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.1.3",
  "release-it": {
    "$schema": "https://unpkg.com/release-it/schema/release-it.json",
    "git": {
      "commitMessage": "chore: release v${version}"
    },
    "github": {
      "release": true
    }
  }
}
